import openai

openai.api_key = "API_KEY"

try:
    response = openai.ChatCompletion.create(
        model="gpt-3.5-turbo",
        messages=[{"role": "system", "content": "Say hello."}]
    )
    print(response.choices[0].message.content)
except openai.OpenAIError as e:
    print("OpenAI API error:", e)